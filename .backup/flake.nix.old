{
  description = "Home Manager configuration - WorkPC (NixOS) and WorkMac (macOS)";

  inputs = {
    # Core
    nixpkgs.url = "github:nixos/nixpkgs/nixos-unstable";

    # Home Manager
    home-manager = {
      url = "github:nix-community/home-manager";
      inputs.nixpkgs.follows = "nixpkgs";
    };

    # Secrets management
    sops-nix = {
      url = "github:Mic92/sops-nix";
      inputs.nixpkgs.follows = "nixpkgs";
    };
  };

  outputs =
    {
      self,
      nixpkgs,
      home-manager,
      sops-nix,
      ...
    }:
    let
      # Supported systems
      supportedSystems = [
        "x86_64-linux"
        "aarch64-darwin"
        "x86_64-darwin"
      ];

      # Helper for per-system packages
      forAllSystems = nixpkgs.lib.genAttrs supportedSystems;

      # Common configuration for all hosts
      mkHomeConfig =
        {
          system,
          username,
          homeDirectory,
          hostModule,
        }:
        home-manager.lib.homeManagerConfiguration {
          pkgs = import nixpkgs {
            inherit system;
            config = {
              allowUnfree = true;
              allowBroken = false;
            };
          };

          extraSpecialArgs = {
            inherit username homeDirectory;
          };

          modules = [
            # Secrets management
            sops-nix.homeManagerModules.sops

            # Common configuration
            ./home/common

            # Host-specific configuration
            hostModule
          ];
        };
    in
    {
      # Formatter for all systems
      formatter = forAllSystems (system: nixpkgs.legacyPackages.${system}.nixfmt);

      # Home configurations per host
      homeConfigurations = {
        # WorkPC - NixOS x86_64
        "neernaredi@workpc" = mkHomeConfig {
          system = "x86_64-linux";
          username = "neernaredi";
          homeDirectory = "/home/neernaredi";
          hostModule = ./home/hosts/workpc.nix;
        };

        # WorkMac - macOS (adjust arch if needed)
        "neernaredi@workmac" = mkHomeConfig {
          system = "aarch64-darwin"; # Change to x86_64-darwin if Intel
          username = "neernaredi";
          homeDirectory = "/Users/neernaredi";
          hostModule = ./home/hosts/workmac.nix;
        };
      };

      # Dev templates
      templates = {
        haskell = {
          path = ./projects/haskell;
          description = "Haskell development environment with cabal/stack";
        };
        typescript = {
          path = ./projects/typescript;
          description = "TypeScript/Node.js development environment";
        };
        rescript = {
          path = ./projects/rescript;
          description = "ReScript development environment";
        };
        python = {
          path = ./projects/python;
          description = "Python development environment with poetry/uv";
        };
      };
    };
}
